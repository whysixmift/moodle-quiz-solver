{
  "name": "moodle-quiz-solver",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-quality local AI-assisted Moodle quiz solver for authorized educational quizzes",
  "main": "dist/cli/index.js",
  "bin": {
    "moodle-solver": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts",
    "solve": "tsx src/cli/index.ts solve",
    "inspect": "tsx src/cli/index.ts inspect",
    "status": "tsx src/cli/index.ts status",
    "resume": "tsx src/cli/index.ts resume",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "moodle",
    "quiz-solver",
    "playwright",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
