# ==============================================================================
# Moodle AI Quiz Solver - Configuration
# ==============================================================================

# Browser Connection
# Set BROWSER_CDP_URL to connect to your running Brave/Chrome instance with remote debugging
BROWSER_CDP_URL=http://127.0.0.1:9222
# Fallback executable path if starting fresh persistent context
BROWSER_EXECUTABLE_PATH=/usr/sbin/brave

# LLM API Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Confidence threshold to accept LLM answers directly (0.0 to 1.0)
# If confidence < threshold and search is enabled, search fallback will be triggered
CONFIDENCE_THRESHOLD=0.75

# Search Fallback Settings
ENABLE_SEARCH=true
MAX_SEARCH_RESULTS=3

# Safety and Navigation
# AUTO_SUBMIT: If false, stops at the final page without submitting and alerts user
AUTO_SUBMIT=false

# Timer Safety Thresholds (in seconds)
WARNING_TIME_SECONDS=600
CRITICAL_TIME_SECONDS=180

# Logging & Performance
LOG_LEVEL=info
TARGET_QUIZ_URL=https://lms.onnocenter.or.id/moodle/mod/quiz/attempt.php
